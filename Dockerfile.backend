# Build stage
FROM golang:1.24-bookworm AS builder

WORKDIR /app

# Enable CGO for libsql compilation
ENV CGO_ENABLED=1

# Copy dependencies
COPY go.mod go.sum ./
RUN go mod download

# Install goose migration tool
RUN go install github.com/pressly/goose/v3/cmd/goose@v3.24.0

# Copy source code
COPY . .

# Compile
RUN GOOS=linux go build -o server-bin .

# Run stage
FROM debian:bookworm-slim

WORKDIR /app

# Install ca-certificates for secure HTTP requests to Realtor API
RUN apt-get update && apt-get install -y ca-certificates sqlite3 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /go/bin/goose /usr/local/bin/goose
COPY --from=builder /app/server-bin .
COPY --from=builder /app/sql ./sql
COPY --from=builder /app/.env.example ./.env

EXPOSE 8080

CMD ["sh", "-c", "goose -dir sql/schema sqlite3 /app/data/local.db up && ./server-bin --server"]
