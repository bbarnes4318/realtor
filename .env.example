# Example .env file for realtor scraper web application
# Copy this file to .env and fill in the real private values.

# JWT Secret key
# This is a key for signing Realtor.com API requests.
JWT_SECRET=""

# Environment
# Options: dev, prod, testing
PLATFORM="dev"

# Log Level
# Options: DEBUG, INFO, WARN, ERROR, FATAL
LOG_LEVEL="INFO"

# Request throttling
# How many requests before cooldown.
THROTTLE_REQUEST_LIMIT="5"

# Save raw agent data
# Set to true if you want to keep raw agent data.
SAVE_RAW_AGENTS=false

# Local Database Configuration
# Path to your local database file.
DB_FILE="file:./local.db"

# Whether to use the local database or Turso.
# Set to true for local, false for Turso.
USE_DB_LOCAL=true

# Turso Database Configuration
# Only needed if USE_DB_LOCAL=false.
DB_URL=""
DB_AUTH_TOKEN=""

# Backend Web Server Port
PORT=8080

# Scrape.do Configuration
# IMPORTANT:
# Do not put your real Scrape.do token in this .env.example file.
# Put the real token in your private .env file or in your server environment.

SCRAPEDO_ENABLED=true
SCRAPEDO_TOKEN=""

# Realtor.com is a US target.
SCRAPEDO_GEO_CODE="US"

# Use Scrape.do residential/mobile proxy network.
SCRAPEDO_SUPER=true

# Realtor's agent endpoint is a JSON API.
# Keep this false first to save credits.
# Change to true only if requests are blocked or incomplete.
SCRAPEDO_RENDER=false

# Forward the Realtor headers through Scrape.do.
SCRAPEDO_CUSTOM_HEADERS=true
SCRAPEDO_FORWARD_HEADERS=true
SCRAPEDO_EXTRA_HEADERS=false

# Scrape.do request timing
SCRAPEDO_TIMEOUT=60000
SCRAPEDO_RETRY_TIMEOUT=15000
SCRAPEDO_DISABLE_RETRY=false

# Browser/device settings used by Scrape.do
SCRAPEDO_DEVICE="desktop"
SCRAPEDO_WAIT_UNTIL="domcontentloaded"
SCRAPEDO_CUSTOM_WAIT=0
SCRAPEDO_WAIT_SELECTOR=""

# Response handling
SCRAPEDO_OUTPUT="raw"
SCRAPEDO_TRANSPARENT_RESPONSE=true
SCRAPEDO_BLOCK_RESOURCES=true